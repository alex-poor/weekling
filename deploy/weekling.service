[Unit]
Description=Weekling calendar server
Documentation=https://github.com/robot5x/weekling
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/weekling
Environment=WEEKLING_DATA_DIR=/var/lib/weekling
Environment=WEEKLING_BIND=0.0.0.0:5232

# Runs as an ephemeral, unprivileged user; /var/lib/weekling is created for it.
DynamicUser=yes
StateDirectory=weekling
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
